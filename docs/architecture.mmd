graph TB
    %% ============= USER & APP LAYER =============
    subgraph user_layer["User & Application Layer"]
        DEV[User Devices<br/>Laptop / Phone / Tablet]
        API[Sovereign API<br/>Go + Gin]
        N8N[n8n Workflows<br/>Local Automation]
    end

    %% ============= LOCAL-FIRST DATA FABRIC =============
    subgraph data_fabric["Local-First Data Fabric"]
        AMCRDT[Automerge CRDT State<br/>Rust Core + Go Wrapper]
        LIBSQL[libSQL Storage<br/>SQLite-Compatible Snapshots]
    end

    %% ============= AI / COMPUTE LAYER =============
    subgraph ai_layer["AI & High-Compute Layer"]
        LOCALLLM[Local LLM 70B+<br/>Private RAG on Documents]
    end

    %% ============= ORCHESTRATION & OS =============
    subgraph orchestration["Orchestration & OS"]
        TALOS[Talos Linux<br/>Immutable K8s Nodes]
        K3S[K3s Cluster<br/>ARM64 + x86]
        KEDA[KEDA Autoscaler<br/>Solar-Aware Scale-to-Zero]
    end

    %% ============= SECURITY & GOVERNANCE =============
    subgraph security["Security, Secrets & Access"]
        YK[YubiKey<br/>Hardware Root of Trust]
        TPORT[Teleport<br/>Audited Access to Cluster]
        INF[Infisical<br/>Secrets Management]
        KOPIA[Kopia<br/>Encrypted, Deduped Backups]
    end

    %% ============= NETWORKING & POWER =============
    subgraph network_power["Networking & Power"]
        TAIL[Tailscale Mesh<br/>Encrypted Overlay Network]
        HALOW[Wi-Fi HaLow MM8108<br/>Long-Range / Low-Power RF]
        TENGB[10GbE Backplane<br/>SFP+ Switch]
        PWR[Na-ion Battery + Solar<br/>Power Telemetry Source]
    end

    %% ============= HARDWARE RACK =============
    subgraph hardware["Sovereign Mini-Rack Hardware"]
        CM5[3x CM5 Nodes<br/>ARM64 Low-Power]
        FW[Framework Desktop<br/>x86 High-Compute + GPU]
        NAS[LincStation N2<br/>TrueNAS Scale + ZFS]
    end

    %% ---------- FLOWS ----------
    %% User & Apps <-> Data Fabric
    DEV -->|Local Network Wi-Fi / HaLow| API
    API --> AMCRDT
    AMCRDT --> LIBSQL
    N8N -->|HTTP/Webhooks| API

    %% Data Fabric <-> LLM
    LIBSQL -->|RAG / Queries| LOCALLLM
    API -->|Inference Requests| LOCALLLM

    %% Orchestration & OS on Hardware
    TALOS --> K3S
    K3S --> CM5
    K3S --> FW
    K3S --> NAS

    %% KEDA <-> Power & Workloads
    PWR -->|Telemetry Metrics| KEDA
    KEDA -->|Scale Heavy Pods| FW
    KEDA -->|Scale Core Services| CM5

    %% Security / Secrets
    YK -->|MFA / SSH / PIV| TPORT
    TPORT -->|Cluster Access| K3S
    INF -->|Inject Secrets| API
    INF -->|Inject Secrets| K3S
    KOPIA -->|Backup Data| LIBSQL
    KOPIA -->|Backup Data| NAS

    %% Networking
    TAIL --> CM5
    TAIL --> FW
    TAIL --> NAS
    DEV -->|Remote Access| TAIL
    HALOW --> CM5
    HALOW --> DEV

    %% Backplane
    NAS --> TENGB
    FW --> TENGB

    %% ---------- STYLES ----------
    style AMCRDT fill:#fff4e1,stroke:#d4a017,stroke-width:1px
    style LIBSQL fill:#e1f5ff,stroke:#007acc,stroke-width:1px
    style LOCALLLM fill:#ffe1e1,stroke:#cc4b4b,stroke-width:1px
    style TALOS fill:#f0e1ff,stroke:#7b4bcc,stroke-width:1px
    style KEDA fill:#ffe1f0,stroke:#cc4b7b,stroke-width:1px
    style YK fill:#ffeb99,stroke:#aa8800,stroke-width:2px
    style hardware stroke:#666,stroke-width:1px
    style data_fabric stroke:#666,stroke-width:1px
    style network_power stroke:#666,stroke-width:1px
    style security stroke:#666,stroke-width:1px
    style orchestration stroke:#666,stroke-width:1px
    style user_layer stroke:#666,stroke-width:1px
    style ai_layer stroke:#666,stroke-width:1px

