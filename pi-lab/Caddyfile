n8n.sourcecodesamurai.com {
                import manual-tls
reverse_proxy https://100.83.4.42:443 {
        header_up Host {host}
        header_up X-Real-IP {remote_ip}
        header_up X-Forwarded-For {remote_ip}
        header_up X-Forwarded-Proto https

        transport http {
            tls_server_name n8n.cuttlefish-gorgon.ts.net
        }
    }
}

