    #--- Cognee --
#--- Cognee --
http://cognee.cuttlefish-gorgon.ts.net {
    import cors

    header {
        Access-Control-Expose-Headers "mcp-session-id"
    }

    reverse_proxy cognee-mcp:8000 {
        flush_interval -1
        
        # force HTTP/1.1 to solve the 421 protocol error
        transport http {
            versions 1.1
        }

        # Use the container name as the Host
        header_up Host "cognee-mcp"
        
        # Pass the real domain in the forwarded headers
        header_up X-Forwarded-Host "cognee.cuttlefish-gorgon.ts.net"
        header_up X-Forwarded-Proto "https"
        header_up X-Real-IP {remote_ip}
    }
}


pi.cuttlefish-gorgon.ts.net {
    tls internal
    reverse_proxy jellyfin:8096
}
