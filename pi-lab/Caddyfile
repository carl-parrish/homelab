 # --- Activity Watch ---
aw.sourcecodesamurai.com {
    import manual-tls
    
    # Handle the API specifically
    handle /api/* {
        # This ensures the extension can talk to the API even if it's 
        # reaching out via a non-standard method
        import cors
        reverse_proxy activitywatch:5600 {
            # Remove the header_up -Origin line if it was there
            header_up Host {host}
        }
    }

    # Handle the Web UI
    handle {
        reverse_proxy aw-webui:80
    }
}


